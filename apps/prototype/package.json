{
  "name": "@brunic/prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Brunic webshop — Next.js-front op de Shopify-catalogus (Storefront API), met offerte-, opmeting- en contactformulieren naar Shopify",
  "scripts": {
    "dev": "next dev --port 3100",
    "prebuild": "node scripts/voor-build.mjs",
    "build": "next build",
    "start": "next start --port 3100",
    "sync": "node scripts/sync-shopify.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
